[Unit]
Description=rs-nightshift goal queue
Documentation=https://github.com/igmarin/rs-nightshift
# Ordering only: start after the network and, if it is installed, Ollama.
After=network-online.target ollama.service

[Service]
Type=oneshot
User=nightshift
Group=nightshift
NoNewPrivileges=true
# Runs the jobs in goals.toml one at a time, then exits. The binary does not
# daemonize, so start it detached:
#   systemctl start --no-block nightshift.service
# Each job that edits code needs its own checkout, named by `repo` in
# goals.toml. Starting the unit again (after a reboot, say) skips the jobs
# already done. See docs/configuration.md, "Goal queue".
WorkingDirectory=/var/lib/nightshift
ExecStartPre=/usr/bin/install -d /var/lib/nightshift/artifacts
ExecStart=/usr/local/bin/nightshift queue --file /var/lib/nightshift/goals.toml --config /var/lib/nightshift/nightshift.toml --out /var/lib/nightshift/artifacts
StandardOutput=append:/var/lib/nightshift/artifacts/queue.log
StandardError=append:/var/lib/nightshift/artifacts/queue.log
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
